<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    android:layoutDirection="rtl"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/app_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/chapter_label"
            style="@style/FaraZaman.Form.SupportingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contractor_violation_chapter" />

        <TextView
            android:id="@+id/chapter_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/iran_sans"
            android:textColor="@color/app_on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="فصل ششم - جمع‌آوری پسماند" />

        <TextView
            android:id="@+id/violation_title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/iran_sans"
            android:textColor="@color/app_on_surface_secondary"
            android:textSize="14sp"
            tools:text="عدم جمع‌آوری پسماند در زمان مقرر" />

        <TextView
            android:id="@+id/submitted_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/app_success_container"
            android:fontFamily="@font/iran_sans"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/contractor_correction_submitted"
            android:textColor="@color/app_on_success_container"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/view_location_button"
                style="@style/FaraZaman.Form.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/contractor_view_location" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_correction_button"
                style="@style/FaraZaman.Form.PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/contractor_register_correction" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
