<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/app_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/app_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="horizontal">

        <View
            android:id="@+id/categoryAccent"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/app_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/action_icon_background">

                    <ImageView
                        android:id="@+id/actionIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        app:tint="@color/app_primary"
                        tools:src="@drawable/ic_nav_schedule" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/actionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/iran_sans"
                        android:textAlignment="viewStart"
                        android:textColor="@color/app_on_surface"
                        android:textDirection="rtl"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="شروع ماموریت" />

                    <TextView
                        android:id="@+id/actionTimestamp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/iran_sans"
                        android:textAlignment="viewStart"
                        android:textColor="@color/app_on_surface_secondary"
                        android:textDirection="rtl"
                        android:textSize="12sp"
                        tools:text="۱۴۰۵/۰۶/۱۴ • ۱۰:۳۰" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/actionDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textColor="@color/app_on_surface"
                android:textDirection="rtl"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="سازمان عمران • قرارداد نظافت منطقه یک"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/actionMetadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/iran_sans"
                android:lineSpacingExtra="4dp"
                android:textAlignment="viewStart"
                android:textColor="@color/app_on_surface_secondary"
                android:textDirection="rtl"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="شروع: ۱۴۰۵/۰۶/۱۴ • ۰۸:۰۰\nتوقف: ۱۴۰۵/۰۶/۱۴ • ۱۰:۳۰"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/actionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/action_status_background"
                android:fontFamily="@font/iran_sans"
                android:textColor="@color/app_on_primary_container"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="متوقف"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/actionOperations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
