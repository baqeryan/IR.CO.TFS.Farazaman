<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:layoutDirection="rtl"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/iran_sans"
            android:gravity="center"
            android:text="@string/contractor_operations_title"
            android:textColor="@color/app_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/workAreaValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/app_surface_container"
            android:fontFamily="@font/iran_sans"
            android:padding="16dp"
            android:textColor="@color/app_on_surface" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startOperationButton"
            style="@style/FaraZaman.Form.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/contractor_start_operation" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/registerActionButton"
            style="@style/FaraZaman.Form.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contractor_register_action" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/correctionsButton"
            style="@style/FaraZaman.Form.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contractor_corrections" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/changeWorkAreaButton"
            style="@style/FaraZaman.Form.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/contractor_change_work_area" />
    </LinearLayout>
</ScrollView>
