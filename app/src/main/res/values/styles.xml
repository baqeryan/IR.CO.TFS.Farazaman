<?xml version="1.0" encoding="utf-8"?>

<resources>
    <!-- Base application theme. -->
    <style name="BaseAppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textViewStyle">@style/FaraZaman.RtlTextView</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
<!--      Customize your theme here.-->
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorOnBackground">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_secondary</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:textColorPrimary">@color/app_on_surface</item>
        <item name="android:textColorSecondary">@color/app_on_surface_secondary</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar">@bool/app_window_light_system_bars</item>
        <item name="android:windowAnimationStyle">@style/FaraZaman.WindowAnimation</item>
<!--        <item name="colorPrimary">@color/colorPrimaryText</item>-->
<!--        <item name="colorPrimary">@color/colorPrimaryDark</item>-->
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/green</item>
        <item name="background">@color/green</item>
        <item name="backgroundColor">@color/green</item>
        <item name="materialAlertDialogBodyTextStyle">@color/green</item>



    </style>

    <style name="AppTheme" parent="BaseAppTheme" />

    <style name="FaraZaman.RtlTextView" parent="Widget.AppCompat.TextView">
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">start</item>
    </style>

    <style name="FaraZaman.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_pop_exit</item>
    </style>

    <style name="FaraZaman.Form.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/app_on_surface</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="FaraZaman.Form.SupportingText" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/app_on_surface_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="FaraZaman.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/button_primary_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/button_primary_container</item>
        <item name="iconTint">@color/button_primary_content</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="FaraZaman.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/button_secondary_content</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/button_secondary_content</item>
        <item name="strokeColor">@color/button_secondary_content</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="FaraZaman.Button.HeaderOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/app_on_header</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/app_on_header</item>
        <item name="strokeColor">@color/app_on_header</item>
    </style>

    <style name="FaraZaman.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/button_secondary_content</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">@color/button_secondary_content</item>
    </style>

    <style name="FaraZaman.Button.Error" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/button_error_content</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/button_error_container</item>
        <item name="iconTint">@color/button_error_content</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="FaraZaman.Button.TonalError" parent="Widget.Material3.Button.TonalButton">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:textColor">@color/button_error_tonal_content</item>
        <item name="backgroundTint">@color/button_error_tonal_container</item>
        <item name="iconTint">@color/button_error_tonal_content</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="FaraZaman.Button.TextError" parent="FaraZaman.Button.Text">
        <item name="android:textColor">@color/app_error</item>
        <item name="iconTint">@color/app_error</item>
    </style>

    <style name="FaraZaman.Form.PrimaryButton" parent="FaraZaman.Button.Primary" />

    <style name="FaraZaman.Form.TextButton" parent="FaraZaman.Button.Text">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Base application theme. -->
    <style name="AppThemeLight" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textViewStyle">@style/FaraZaman.RtlTextView</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <!-- Customize your theme here
        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkLight</item>
        <item name="colorAccent">@color/colorAccentLight</item>
        -->
    </style>
    <style name="SupervisorTabText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="fontFamily">@font/iran_sans</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TrackLoggerTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:textViewStyle">@style/FaraZaman.RtlTextView</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorPrimary">@color/colorPrimaryText</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="background">@color/colorPrimaryText</item>
        <item name="backgroundColor">@color/colorPrimaryText</item>
        <item name="android:fontFamily">@font/iran_sans</item>
    </style>

    <!-- RTL Preferences Theme -->
    <style name="PreferencesRTLTheme" parent="Theme.AppCompat.DayNight">
        <item name="android:fontFamily">@font/iran_sans</item>
        <item name="android:layoutDirection">rtl</item>
        <item name="android:textViewStyle">@style/FaraZaman.RtlTextView</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:gravity">start</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/green</item>
    </style>

</resources>
